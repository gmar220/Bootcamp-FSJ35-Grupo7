# MySQL (usa contraseñas locales de desarrollo; nunca subas el .env real)
MYSQL_ROOT_PASSWORD=cambia_esta_clave_root
MYSQL_DATABASE=ecommerce
MYSQL_USER=ecommerce_user
MYSQL_PASSWORD=cambia_esta_clave

# Laravel: genera una clave con: php artisan key:generate --show
# Copia el resultado aquí, conservando el prefijo base64:
APP_KEY=base64:REEMPLAZAR_CON_CLAVE_GENERADA

# Stripe: claves de prueba, nunca claves secretas en NEXT_PUBLIC_*
STRIPE_KEY=pk_test_REEMPLAZAR
STRIPE_SECRET=sk_test_REEMPLAZAR
STRIPE_WEBHOOK_SECRET=whsec_REEMPLAZAR
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_REEMPLAZAR
